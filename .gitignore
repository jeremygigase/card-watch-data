/catalog/
/history/
/weekly/
/latest/
/manifest.json
/mapping/cards.json

# The original daily files go to a GitHub release, not into the repository.
archive/
node_modules/
.DS_Store

# Local mapping run: TCGdex download and the review page
.cache/
mapping-report.html
.netlify/
